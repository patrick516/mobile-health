generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //  url      = env("DATABASE_URL")
}

// ─── ENUMS 
enum Role {
  CCW
  NURSE
  DISTRICT_OFFICER
  ADMIN
  SUPER_ADMIN
}

enum StructureType {
  BRICK
  MUD
  IRON_SHEET
  GRASS_THATCH
  OTHER
}

enum WaterSource {
  BOREHOLE
  RIVER
  PIPED
  PROTECTED_WELL
  UNPROTECTED_WELL
  OTHER
}

enum LatrineType {
  IMPROVED_PIT
  TRADITIONAL_PIT
  VIP
  FLUSH_TOILET
  NONE
}

enum DistanceToFacility {
  UNDER_5KM
  BETWEEN_5_10KM
  OVER_10KM
}

enum MemberStatus {
  ACTIVE
  DECEASED
  RELOCATED
  UNKNOWN
}

enum HouseholdStatus {
  ACTIVE
  VACANT
  DEMOLISHED
  RELOCATED
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum Relationship {
  HEAD
  SPOUSE
  CHILD
  PARENT
  OTHER_RELATIVE
  NON_RELATIVE
}

enum VisitType {
  ROUTINE
  SICK
  FOLLOW_UP
  DRUG_DISPENSING_ONLY
}

enum MuacStatus {
  NORMAL
  MODERATE_MALNUTRITION
  SEVERE_MALNUTRITION
}

enum ReferralUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum ReferralStatus {
  PENDING
  OVERDUE
  ARRIVED
  TREATED
  FEEDBACK_SENT
  COMPLETED
  MISSED
}

enum ImmunisationStatus {
  DUE
  GIVEN
  OVERDUE
  MISSED
}

enum AncStatus {
  SCHEDULED
  ATTENDED
  MISSED
  OVERDUE
}

enum StockRequestStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
}

enum SyncRecordType {
  HOUSEHOLD
  MEMBER
  VISIT
  REFERRAL
  IMMUNISATION
  DRUG_DISPENSE
  STOCK_REQUEST
  ANC_VISIT
}

enum FacilityType {
  DISTRICT_HOSPITAL
  TA_HOSPITAL
  CLINIC
}

// ─── GEOGRAPHY 

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts District[]

  @@map("regions")
}

model District {
  id        String   @id @default(uuid())
  name      String
  regionId  String   @map("region_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region                 Region                 @relation(fields: [regionId], references: [id])
  traditionalAuthorities TraditionalAuthority[]
  facilities             Facility[]

  @@unique([name, regionId])
  @@map("districts")
}

model TraditionalAuthority {
  id         String   @id @default(uuid())
  name       String
  districtId String   @map("district_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  district          District           @relation(fields: [districtId], references: [id])
  zones             Zone[]
  userTaAllocations UserTaAllocation[]
  facilities        Facility[]

  @@unique([name, districtId])
  @@map("traditional_authorities")
}

model Zone {
  id        String   @id @default(uuid())
  name      String
  taId      String   @map("ta_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ta                  TraditionalAuthority @relation(fields: [taId], references: [id])
  villages            Village[]
  userZoneAllocations UserZoneAllocation[]

  @@unique([name, taId])
  @@map("zones")
}

model Village {
  id                 String   @id @default(uuid())
  name               String
  zoneId             String   @map("zone_id")
  gpsLat             Float?   @map("gps_lat")
  gpsLng             Float?   @map("gps_lng")
  createdByUserId    String   @map("created_by_user_id")
  isVerified         Boolean  @default(false) @map("is_verified")
  canonicalVillageId String?  @map("canonical_village_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  zone          Zone        @relation(fields: [zoneId], references: [id])
  createdByUser User        @relation("VillageCreator", fields: [createdByUserId], references: [id])
  canonicalOf   Village?    @relation("VillageCanonical", fields: [canonicalVillageId], references: [id])
  aliases       Village[]   @relation("VillageCanonical")
  households    Household[]

  @@map("villages")
}

// ─── USERS & ALLOCATIONS 

model User {
  id          String   @id @default(uuid())
  fullName    String   @map("full_name")
  phoneNumber String   @unique @map("phone_number")
  pinHash     String   @map("pin_hash")
  role        Role
  facilityId  String?  @map("facility_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  facility             Facility?            @relation("FacilityStaff", fields: [facilityId], references: [id])
  zoneAllocations      UserZoneAllocation[] @relation("AllocatedUser")
  taAllocations        UserTaAllocation[]   @relation("AllocatedTaUser")
  allocatedByZone      UserZoneAllocation[] @relation("ZoneAllocator")
  allocatedByTa        UserTaAllocation[]   @relation("TaAllocator")
  createdVillages      Village[]            @relation("VillageCreator")
  registeredHouseholds Household[]          @relation("HouseholdRegistrar")
  visits               Visit[]
  referralsMade        Referral[]           @relation("ReferringUser")
  immunisationsGiven   Immunisation[]
  drugDispenses        DrugDispense[]
  drugStock            DrugStock[]
  stockRequests        StockRequest[]       @relation("StockRequester")
  stockApprovals       StockRequest[]       @relation("StockApprover")
  auditLogs            AuditLog[]
  assignedMembers      HouseholdMember[]    @relation("AssignedCCW")

  loginLockouts    LoginLockout[] @relation("LockoutUser")
  unlockedLockouts LoginLockout[] @relation("UnlockedByAdmin")

  @@map("users")
}

model UserZoneAllocation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  zoneId        String   @map("zone_id")
  allocatedById String   @map("allocated_by_id")
  allocatedAt   DateTime @default(now()) @map("allocated_at")

  user        User @relation("AllocatedUser", fields: [userId], references: [id])
  zone        Zone @relation(fields: [zoneId], references: [id])
  allocatedBy User @relation("ZoneAllocator", fields: [allocatedById], references: [id])

  @@unique([userId, zoneId])
  @@map("user_zone_allocations")
}

model UserTaAllocation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  taId          String   @map("ta_id")
  allocatedById String   @map("allocated_by_id")
  allocatedAt   DateTime @default(now()) @map("allocated_at")

  user        User                 @relation("AllocatedTaUser", fields: [userId], references: [id])
  ta          TraditionalAuthority @relation(fields: [taId], references: [id])
  allocatedBy User                 @relation("TaAllocator", fields: [allocatedById], references: [id])

  @@unique([userId, taId])
  @@map("user_ta_allocations")
}

// ─── HOUSEHOLDS 

model Household {
  id                     String             @id @default(uuid())
  localId                String             @unique @map("local_id")
  householdNumber        String             @unique @map("household_number")
  villageId              String             @map("village_id")
  headOfHouseholdName    String             @map("head_of_household_name")
  headPhone              String?            @map("head_phone")
  structureType          StructureType      @map("structure_type")
  waterSource            WaterSource        @map("water_source")
  latrinePresent         Boolean            @map("latrine_present")
  latrineType            LatrineType?       @map("latrine_type")
  handwashingFacility    Boolean            @map("handwashing_facility")
  handwashingWithSoap    Boolean?           @map("handwashing_with_soap")
  distanceToFacility     DistanceToFacility @map("distance_to_facility")
  mosquitoNets           String?            @map("mosquito_nets")
  numberOfRooms          Int?               @map("number_of_rooms")
  landmark               String?
  gpsLat                 Float?             @map("gps_lat")
  gpsLng                 Float?             @map("gps_lng")
  headNationalId      String?            @unique @map("head_national_id")
  consentGiven           Boolean            @default(false) @map("consent_given")
  consentSignatureUrl    String?            @map("consent_signature_url")
  registeredByUserId     String             @map("registered_by_user_id")
  status                 HouseholdStatus    @default(ACTIVE)
  relocatedAt            DateTime?          @map("relocated_at")
  relocationReason       String?            @map("relocation_reason")
  relocatedToHouseholdId String?            @unique @map("relocated_to_household_id")
  syncedAt               DateTime?          @map("synced_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  village       Village           @relation(fields: [villageId], references: [id])
  registeredBy  User              @relation("HouseholdRegistrar", fields: [registeredByUserId], references: [id])
  members       HouseholdMember[]
  relocatedTo   Household?        @relation("HouseholdRelocation", fields: [relocatedToHouseholdId], references: [id])
  relocatedFrom Household?        @relation("HouseholdRelocation")

  @@map("households")
}

model HouseholdMember {
  id                   String       @id @default(uuid())
  localId              String       @unique @map("local_id")
  householdId          String       @map("household_id")
  fullName             String       @map("full_name")
  dateOfBirth          DateTime?    @map("date_of_birth")
  estimatedAge         Int?         @map("estimated_age")
  sex                  Sex
  relationshipToHead   Relationship @map("relationship_to_head")
  isPregnant           Boolean      @default(false) @map("is_pregnant")
  lmpDate              DateTime?    @map("lmp_date")
  expectedDeliveryDate DateTime?    @map("expected_delivery_date")
  chronicIllnesses     Json?        @map("chronic_illnesses")
  hasDisability        Boolean      @default(false) @map("has_disability")
  disabilityType       String?      @map("disability_type")
 nationalId           String?      @unique @map("national_id")
  phone                String?
  status               MemberStatus @default(ACTIVE)
  archivedAt           DateTime?    @map("archived_at")
  assignedCcwId        String?      @map("assigned_ccw_id")
  syncedAt             DateTime?    @map("synced_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  household             Household              @relation(fields: [householdId], references: [id])
  assignedCcw           User?                  @relation("AssignedCCW", fields: [assignedCcwId], references: [id])
  visits                Visit[]
  referrals             Referral[]
  immunisations         Immunisation[]
  immunisationSchedules ImmunisationSchedule[]
  ancVisits             AncVisit[]
  drugDispenses         DrugDispense[]

  @@map("household_members")
}

// ─── VISITS 

model Visit {
  id             String      @id @default(uuid())
  localId        String      @unique @map("local_id")
  memberId       String      @map("member_id")
  householdId    String      @map("household_id")
  chwId          String      @map("chw_id")
  visitedAt      DateTime    @map("visited_at")
  visitType      VisitType   @map("visit_type")
  symptoms       Json?
  temperature    Float?
  muacMm         Int?        @map("muac_mm")
  muacStatus     MuacStatus? @map("muac_status")
  dangerSigns    Json?       @map("danger_signs")
  referralNeeded Boolean     @default(false) @map("referral_needed")
  gpsLat         Float?      @map("gps_lat")
  gpsLng         Float?      @map("gps_lng")
  notes          String?
  conflictFlag   Boolean     @default(false) @map("conflict_flag")
  syncedAt       DateTime?   @map("synced_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  member    HouseholdMember @relation(fields: [memberId], references: [id])
  chw       User            @relation(fields: [chwId], references: [id])
  referrals Referral[]
  dispenses DrugDispense[]

  @@map("visits")
}

// ─── REFERRALS 

model Facility {
  id           String        @id @default(uuid())
  name         String
  facilityType FacilityType? @map("facility_type")
  districtId   String?       @map("district_id")
  taId         String?       @map("ta_id")
  gpsLat       Float?        @map("gps_lat")
  gpsLng       Float?        @map("gps_lng")
  createdAt    DateTime      @default(now()) @map("created_at")

  district  District?             @relation(fields: [districtId], references: [id])
  ta        TraditionalAuthority? @relation(fields: [taId], references: [id])
  referrals Referral[]
  staff     User[]                @relation("FacilityStaff")

  @@map("facilities")
}

model Referral {
  id                    String          @id @default(uuid())
  localId               String          @unique @map("local_id")
  visitId               String          @map("visit_id")
  memberId              String          @map("member_id")
  referringUserId       String          @map("referring_user_id")
  destinationFacilityId String?         @map("destination_facility_id")
  reason                String
  urgency               ReferralUrgency
  status                ReferralStatus  @default(PENDING)
  dueBy                 DateTime?       @map("due_by")
  arrivedAt             DateTime?       @map("arrived_at")
  treatedAt             DateTime?       @map("treated_at")
  diagnosis             String?
  treatmentGiven        String?         @map("treatment_given")
  feedbackNote          String?         @map("feedback_note")
  resolvedAt            DateTime?       @map("resolved_at")
  syncedAt              DateTime?       @map("synced_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  visit               Visit           @relation(fields: [visitId], references: [id])
  member              HouseholdMember @relation(fields: [memberId], references: [id])
  referringUser       User            @relation("ReferringUser", fields: [referringUserId], references: [id])
  destinationFacility Facility?       @relation(fields: [destinationFacilityId], references: [id])

  @@map("referrals")
}

// ─── IMMUNISATIONS 

model Immunisation {
  id                 String    @id @default(uuid())
  localId            String    @unique @map("local_id")
  memberId           String    @map("member_id")
  vaccineCode        String    @map("vaccine_code")
  doseNumber         Int       @map("dose_number")
  givenAt            DateTime  @map("given_at")
  givenByUserId      String    @map("given_by_user_id")
  batchNumber        String?   @map("batch_number")
  route              String?
  nextDueDate        DateTime? @map("next_due_date")
  facilityOrOutreach String?   @map("facility_or_outreach")
  syncedAt           DateTime? @map("synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  member      HouseholdMember @relation(fields: [memberId], references: [id])
  givenByUser User            @relation(fields: [givenByUserId], references: [id])

  @@map("immunisations")
}

model ImmunisationSchedule {
  id          String             @id @default(uuid())
  memberId    String             @map("member_id")
  vaccineCode String             @map("vaccine_code")
  doseNumber  Int                @map("dose_number")
  dueDate     DateTime           @map("due_date")
  status      ImmunisationStatus @default(DUE)
  givenAt     DateTime?          @map("given_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  member HouseholdMember @relation(fields: [memberId], references: [id])

  @@unique([memberId, vaccineCode, doseNumber])
  @@map("immunisation_schedules")
}

// ─── ANC 

model AncVisit {
  id           String    @id @default(uuid())
  memberId     String    @map("member_id")
  ancNumber    Int       @map("anc_number")
  expectedDate DateTime  @map("expected_date")
  status       AncStatus @default(SCHEDULED)
  attendedDate DateTime? @map("attended_date")
  facilityId   String?   @map("facility_id")
  notes        String?
  syncedAt     DateTime? @map("synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  member HouseholdMember @relation(fields: [memberId], references: [id])

  @@unique([memberId, ancNumber])
  @@map("anc_visits")
}

// ─── DRUGS 

model Drug {
  id               String   @id @default(uuid())
  drugCode         String   @unique @map("drug_code")
  nameEnglish      String   @map("name_english")
  nameChichewa     String   @map("name_chichewa")
  unit             String
  minimumThreshold Int      @map("minimum_threshold")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  stock     DrugStock[]
  dispenses DrugDispense[]
  requests  StockRequest[]

  @@map("drugs")
}

model DrugStock {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  drugId          String    @map("drug_id")
  quantityCurrent Int       @map("quantity_current")
  quantityMinimum Int       @map("quantity_minimum")
  lastRestockedAt DateTime? @map("last_restocked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  drug Drug @relation(fields: [drugId], references: [id])

  @@unique([userId, drugId])
  @@map("drug_stock")
}

model DrugDispense {
  id                String    @id @default(uuid())
  localId           String    @unique @map("local_id")
  visitId           String    @map("visit_id")
  memberId          String    @map("member_id")
  drugId            String    @map("drug_id")
  quantityDispensed Int       @map("quantity_dispensed")
  dispensedById     String    @map("dispensed_by_id")
  dispensedAt       DateTime  @map("dispensed_at")
  syncedAt          DateTime? @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  visit       Visit           @relation(fields: [visitId], references: [id])
  member      HouseholdMember @relation(fields: [memberId], references: [id])
  drug        Drug            @relation(fields: [drugId], references: [id])
  dispensedBy User            @relation(fields: [dispensedById], references: [id])

  @@map("drug_dispenses")
}

model StockRequest {
  id                String             @id @default(uuid())
  requestingUserId  String             @map("requesting_user_id")
  drugId            String             @map("drug_id")
  quantityRequested Int                @map("quantity_requested")
  status            StockRequestStatus @default(PENDING)
  approvedById      String?            @map("approved_by_id")
  fulfilledAt       DateTime?          @map("fulfilled_at")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  requestingUser User  @relation("StockRequester", fields: [requestingUserId], references: [id])
  drug           Drug  @relation(fields: [drugId], references: [id])
  approvedBy     User? @relation("StockApprover", fields: [approvedById], references: [id])

  @@map("stock_requests")
}

// ─── SYNC CONFLICTS 

model SyncConflict {
  id             String         @id @default(uuid())
  localId        String         @map("local_id")
  recordType     SyncRecordType @map("record_type")
  winningPayload Json           @map("winning_payload")
  losingPayload  Json           @map("losing_payload")
  resolved       Boolean        @default(false)
  resolvedById   String?        @map("resolved_by_id")
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("sync_conflicts")
}

// ─── LOGIN SECURITY 

model LoginAttempt {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  ipAddress   String?  @map("ip_address")
  deviceId    String?  @map("device_id")
  success     Boolean  @default(false)
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@map("login_attempts")
}

model LoginLockout {
  id            String    @id @default(uuid())
  phoneNumber   String    @unique @map("phone_number")
  lockedUntil   DateTime? @map("locked_until")
  lockoutCount  Int       @default(0) @map("lockout_count")
  lastLockoutAt DateTime? @map("last_lockout_at")
  isPermanent   Boolean   @default(false) @map("is_permanent")
  unlockedAt    DateTime? @map("unlocked_at")
  unlockedById  String?   @map("unlocked_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user       User  @relation("LockoutUser", fields: [phoneNumber], references: [phoneNumber])
  unlockedBy User? @relation("UnlockedByAdmin", fields: [unlockedById], references: [id])

  @@map("login_lockouts")
}

model UnknownLoginAttempt {
  id             String    @id @default(uuid())
  phoneNumber    String    @unique @map("phone_number")
  attemptCount   Int       @default(1)
  firstAttemptAt DateTime  @default(now()) @map("first_attempt_at")
  lastAttemptAt  DateTime  @default(now()) @map("last_attempt_at")
  ipAddress      String?   @map("ip_address")
  isLocked       Boolean   @default(false) @map("is_locked")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("unknown_login_attempts")
}

// ─── AUDIT LOG 

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  recordType String   @map("record_type")
  recordId   String   @map("record_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  deviceId   String?  @map("device_id")
  loggedAt   DateTime @default(now()) @map("logged_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}
