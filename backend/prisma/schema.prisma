// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Gender {
  male
  female
}

enum SmokingPref {
  never
  socially
  regularly
  trying_to_quit
}

enum AlcoholPref {
  never
  socially
  regularly
}

enum ChildrenPref {
  have_and_want_more
  have_dont_want_more
  dont_have_want
  dont_have_dont_want
}

enum RelationshipGoal {
  serious
  casual
  friendship
  not_sure
}

enum ExercisePref {
  never
  sometimes
  often
  daily
}

enum DietPref {
  omnivore
  vegetarian
  vegan
  pescatarian
  halal
  kosher
}

enum ReligionPref {
  christian
  muslim
  hindu
  buddhist
  none
  other
}

enum EducationLevel {
  high_school
  diploma
  bachelors
  masters
  phd
  other
}

enum MessageType {
  text
  voice
}

enum NotificationType {
  new_match
  new_message
  new_like
  profile_view
}

enum ReportReason {
  spam
  inappropriate_content
  fake_profile
  harassment
  other
}

enum ReportStatus {
  pending     // just submitted
  reviewing   // admin opened it
  resolved    // admin replied and closed it
}

enum PaymentMethod {
  mobile_money
  card
}

enum SubscriptionPlan {
  monthly
  yearly
}

enum SwipeAction {
  like
  pass
}

enum Platform {
  ios
  android
}

enum LookingFor {
  men
  women
  everyone
}

enum VerificationStatus {
  unsubmitted  // user hasn't submitted docs yet
  pending      // submitted, waiting for admin review
  approved     // admin approved
  rejected     // admin rejected
}

enum AdminRole {
  super_admin  // full access
  moderator    // content moderation only
}

enum UserStatus {
  active
  suspended    // temporarily banned
  banned       // permanently banned
}

enum DocumentType {
  national_id
  passport
  drivers_license
}

// ─────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         AdminRole @default(moderator)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Actions performed by this admin
  verifications  VerificationRequest[] @relation("AdminVerifier")
  resolvedReports Report[]             @relation("AdminResolver")
  manualMatches   Match[]              @relation("AdminMatchCreator")
  broadcastsSent  BroadcastNotification[]
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  dateOfBirth   DateTime?
  age           Int?
  gender        Gender?
  bio           String?    @db.VarChar(500)
  profession    String?
  verified      Boolean    @default(false)
  isPremium     Boolean    @default(false)
  online        Boolean    @default(false)
  lastSeenAt    DateTime?
  status        UserStatus @default(active)
  suspendedUntil DateTime?
  bannedReason  String?

  // Location
  country       String?
  district      String?
  town          String?

  // Main profile photo URL — kept for quick access
  photoUrl      String?

  // Interests
  interests     String[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  photos                UserPhoto[]
  lifestyle             Lifestyle?
  preferences           DiscoveryPreference?
  verificationRequest   VerificationRequest?
  sentSwipes            Swipe[]              @relation("SwipeSender")
  receivedSwipes        Swipe[]              @relation("SwipeReceiver")
  matchesAsUser1        Match[]              @relation("MatchUser1")
  matchesAsUser2        Match[]              @relation("MatchUser2")
  conversations         ConversationParticipant[]
  sentMessages          Message[]            @relation("MessageSender")
  notifications         Notification[]
  subscription          Subscription?
  pushTokens            PushToken[]
  reportsSubmitted      Report[]             @relation("ReportSubmitter")
  reportsReceived       Report[]             @relation("ReportSubject")
  blocksInitiated       Block[]              @relation("BlockInitiator")
  blocksReceived        Block[]              @relation("BlockTarget")
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]

  @@index([email])
  @@index([gender])
  @@index([country, district])
  @@index([isPremium])
  @@index([online])
  @@index([status])
}

// ─────────────────────────────────────────────
// USER PHOTOS — multiple photos per user
// ─────────────────────────────────────────────

model UserPhoto {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  url         String
  isMain      Boolean  @default(false) // main photo shown on cards
  order       Int      @default(0)     // display order on profile
  removedByAdmin Boolean @default(false)
  removedAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, isMain])
}

// ─────────────────────────────────────────────
// IDENTITY VERIFICATION
// ─────────────────────────────────────────────

model VerificationRequest {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType DocumentType
  documentUrl  String             // uploaded ID document URL
  selfieUrl    String             // selfie holding document

  status       VerificationStatus @default(pending)
  reviewedById String?
  reviewedBy   Admin?             @relation("AdminVerifier", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectionReason String?         // if rejected, why

  submittedAt  DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────
// LIFESTYLE
// ─────────────────────────────────────────────

model Lifestyle {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  smoking          SmokingPref?
  alcohol          AlcoholPref?
  children         ChildrenPref?
  relationshipGoal RelationshipGoal?
  exercise         ExercisePref?
  diet             DietPref?
  religion         ReligionPref?
  education        EducationLevel?
  height           String?
  zodiac           String?

  updatedAt        DateTime         @updatedAt
}

// ─────────────────────────────────────────────
// DISCOVERY PREFERENCES
// ─────────────────────────────────────────────

model DiscoveryPreference {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  lookingFor       LookingFor       @default(everyone)
  minAge           Int              @default(18)
  maxAge           Int              @default(99)
  maxDistanceKm    Int              @default(100)

  smoking          SmokingPref?
  alcohol          AlcoholPref?
  children         ChildrenPref?
  relationshipGoal RelationshipGoal?
  exercise         ExercisePref?
  diet             DietPref?
  religion         ReligionPref?
  education        EducationLevel?
  interests        String[]

  updatedAt        DateTime         @updatedAt
}

// ─────────────────────────────────────────────
// SWIPES
// ─────────────────────────────────────────────

model Swipe {
  id          String      @id @default(cuid())
  senderId    String
  receiverId  String
  action      SwipeAction

  sender      User        @relation("SwipeSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver    User        @relation("SwipeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

// ─────────────────────────────────────────────
// MATCHES
// ─────────────────────────────────────────────

model Match {
  id           String   @id @default(cuid())
  user1Id      String
  user2Id      String
  matchedAt    DateTime @default(now())

  // Manual match created by admin
  createdByAdminId String?
  createdByAdmin   Admin?  @relation("AdminMatchCreator", fields: [createdByAdminId], references: [id])

  user1        User     @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2        User     @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  conversation Conversation?

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// ─────────────────────────────────────────────
// CONVERSATIONS & MESSAGES
// ─────────────────────────────────────────────

model Conversation {
  id           String    @id @default(cuid())
  matchId      String?   @unique
  match        Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId],         references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(text)

  text           String?     @db.VarChar(2000)
  voiceUri       String?
  voiceDuration  Int?

  read           Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─────────────────────────────────────────────
// PREMIUM / SUBSCRIPTIONS
// ─────────────────────────────────────────────

model Subscription {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan             SubscriptionPlan
  isActive         Boolean          @default(false)
  startedAt        DateTime?
  expiresAt        DateTime?
  cancelledAt      DateTime?

  // manually granted by admin
  grantedByAdmin   Boolean          @default(false)

  paymentMethod    PaymentMethod?
  paymentSessionId String?
  transactionRef   String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)

  refUserId   String?
  refMatchId  String?
  refMsgId    String?

  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  platform  Platform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// BROADCAST NOTIFICATIONS (Admin → all users)
// ─────────────────────────────────────────────

model BroadcastNotification {
  id          String   @id @default(cuid())
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id])

  title       String
  body        String

  // Optional filters — null means send to everyone
  targetGender  Gender?
  targetCountry String?
  isPremiumOnly Boolean @default(false)

  sentAt      DateTime @default(now())
  totalSent   Int      @default(0)
}

// ─────────────────────────────────────────────
// REPORTS & BLOCKS
// ─────────────────────────────────────────────

model Report {
  id          String       @id @default(cuid())
  submitterId String
  subjectId   String
  reason      ReportReason
  description String?      @db.VarChar(500)

  status      ReportStatus @default(pending)

  // Admin resolution
  resolvedById  String?
  resolvedBy    Admin?   @relation("AdminResolver", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?
  adminReply    String?  // the email reply sent to reporter

  submitter   User         @relation("ReportSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  subject     User         @relation("ReportSubject",   fields: [subjectId],   references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([subjectId])
  @@index([status])
  @@index([resolvedById])
}

model Block {
  id          String   @id @default(cuid())
  initiatorId String
  targetId    String

  initiator   User     @relation("BlockInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  target      User     @relation("BlockTarget",    fields: [targetId],    references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([initiatorId, targetId])
  @@index([initiatorId])
  @@index([targetId])
}

// ─────────────────────────────────────────────
// AUTH TOKENS
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([token])
}

// ─────────────────────────────────────────────
// LOCATION DATA
// ─────────────────────────────────────────────

model Country {
  code      String     @id
  name      String
  flag      String?
  active    Boolean    @default(true)

  districts District[]
}

model District {
  id          String   @id @default(cuid())
  name        String
  countryCode String
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  towns       Town[]

  @@index([countryCode])
}

model Town {
  id         String   @id @default(cuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId])
}